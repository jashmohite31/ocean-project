# OceanX Backend Environment Variables
# Copy this file to .env and fill in your values before starting the backend.

# ─── Gemini AI (Required for AI-powered OceanX Assistant) ───────────────────
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: INCOIS API (for live data integration) ──────────────────────
# INCOIS_API_BASE_URL=https://incois.gov.in/...
# INCOIS_API_KEY=

# ─── Server Settings ────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
